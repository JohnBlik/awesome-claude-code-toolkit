{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "detail": "Start the Vite dev server (auto-runs in Codespaces)",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "vite",
          "pattern": [
            {
              "regexp": "^.*$",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "VITE",
            "endsPattern": "ready in"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "build",
      "detail": "Type-check and produce a production bundle",
      "type": "npm",
      "script": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "preview",
      "detail": "Serve the production build",
      "type": "npm",
      "script": "preview",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
